# Copy to .env.local and fill in. Never commit .env.local. Check with: npm run check:env

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # a.k.a. "publishable" key in newer dashboards
SUPABASE_SERVICE_ROLE_KEY=            # a.k.a. "secret" key, server only, never NEXT_PUBLIC
DATABASE_URL=                         # Session pooler connection string (IPv4-friendly), for scripts/seed
SUPABASE_PROJECT_REF=

# AI
AI_PRIMARY=gemini                     # gemini | groq | template
GEMINI_API_KEY=                       # optional
GEMINI_MODEL=                         # for example gemini-3.5-flash-lite
GROQ_API_KEY=                         # optional
GROQ_MODEL=                           # for example openai/gpt-oss-120b

# App
DEMO_TODAY=2026-10-15                 # engine's "today" for the seeded demo
DEMO_USER_PASSWORD=                   # any random string, 16+ characters; shared by the demo personas
ADMIN_RESET_TOKEN=                    # any random string, 24+ characters; guards the reset endpoint
