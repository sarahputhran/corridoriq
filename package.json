{
  "name": "corridoriq",
  "version": "0.1.0",
  "description": "Coordinated road-cutting permits: a rules engine and workflow that catch overlapping road works before the road is dug twice.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check:env": "tsx scripts/check-env.ts",
    "data:process": "tsx scripts/build-corridor.ts && tsx scripts/process-reference.ts && tsx scripts/process-permits.ts && tsx scripts/process-infra.ts && tsx scripts/export-fixtures.ts",
    "data:verify": "tsx scripts/verify-data.ts",
    "data": "npm run data:process && npm run data:verify",
    "engine:report": "tsx scripts/engine-report.ts",
    "db:ping": "tsx scripts/db-ping.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrations": "tsx scripts/db-migrate.ts --list",
    "db:seed": "tsx scripts/seed.ts",
    "postinstall": "node scripts/copy-map-worker.mjs",
    "predev": "node scripts/copy-map-worker.mjs",
    "prebuild": "node scripts/copy-map-worker.mjs",
    "db:verify": "tsx scripts/verify-seed.ts",
    "ai:explain": "tsx scripts/ai-explain.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@turf/turf": "^7.4.0",
    "d3-scale": "^4.0.2",
    "maplibre-gl": "^6.13.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
